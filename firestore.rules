rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // HELPER: ¿Es admin?
    //  - Custom claim "admin" (lo asigna la Cloud Function syncAdminClaim)
    //  - Fallback: email del dueño de la liga (bootstrap, por si el claim
    //    aún no se ha propagado al token)
    // ─────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'mdiazsalas7@gmail.com'
      );
    }

    // ─────────────────────────────────────────────
    // USUARIOS
    //  - Cada quien lee su propio perfil; admin lee todos
    //  - Al registrarse solo puede crearse con rol 'pendiente'
    //  - Un usuario NO puede cambiar su propio rol
    //    (solo un admin, vía la regla catch-all de abajo)
    // ─────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.rol == 'pendiente';
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.rol == resource.data.rol;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────
    // FCM_TOKENS
    //  - Cualquiera (incluso sin login) puede registrar SU token,
    //    pero el ID del doc debe ser el propio token y solo se
    //    permiten los campos exactos que escribe useNotifications.ts
    //  - Leer/borrar la lista completa: solo admin (las Functions
    //    usan el Admin SDK, que ignora estas reglas)
    // ─────────────────────────────────────────────
    match /fcm_tokens/{tokenId} {
      allow read, delete: if isAdmin();
      allow create, update: if request.resource.data.token == tokenId
        && tokenId.size() > 20 && tokenId.size() < 400
        && request.resource.data.keys().hasOnly(['token', 'userId', 'platform', 'updatedAt']);
    }

    // ─────────────────────────────────────────────
    // MESA_ESTADO — solo la mesa técnica (admin) lo usa
    // ─────────────────────────────────────────────
    match /mesa_estado/{matchId} {
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // FORMA21S + subcolección jugadores
    // ─────────────────────────────────────────────
    match /forma21s/{formaId} {
      allow read: if true;
      allow write: if isAdmin();

      match /jugadores/{jugadorId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ─────────────────────────────────────────────
    // CATCH-ALL: todas las demás colecciones
    //  (equipos*, calendario*, jugadores*, noticias, entrevistas,
    //   stats_partido, jugadas_partido, config_torneo, ...)
    //  - Lectura pública (la app muestra todo sin login)
    //  - Escritura: SOLO admin
    //  Nota: las colecciones sensibles se excluyen de la lectura
    //  pública porque ya tienen su propio bloque arriba.
    // ─────────────────────────────────────────────
    match /{col}/{docId} {
      allow read: if !(col in ['usuarios', 'fcm_tokens', 'mesa_estado']);
      allow write: if isAdmin();
    }
  }
}
