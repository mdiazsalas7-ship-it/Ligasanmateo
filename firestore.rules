rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // HELPER: ¿Es admin?
    //  - Custom claim "admin" (lo asigna la Cloud Function syncAdminClaim)
    //  - Fallback: correos autorizados (bootstrap, por si el claim
    //    aún no se propagó al token, o si las Functions están caídas
    //    por un corte de facturación)
    //
    //  ⚠️ Esta lista debe coincidir con ADMIN_EMAILS en:
    //       - src/ligaConfig.ts
    //       - storage.rules
    //       - functions/src/index.ts
    // ─────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'adminlibasan@gmail.com' ||
        request.auth.token.email == 'yolfren1985@gmail.com'
      );
    }

    // ─────────────────────────────────────────────
    // FCM_TOKENS
    //  - Cualquiera (incluso sin login) puede registrar SU token,
    //    pero el ID del doc debe ser el propio token y solo se
    //    permiten los campos exactos que escribe useNotifications.ts
    //  - Leer/borrar la lista completa: solo admin (las Functions
    //    usan el Admin SDK, que ignora estas reglas)
    // ─────────────────────────────────────────────
    match /fcm_tokens/{tokenId} {
      allow read, delete: if isAdmin();
      allow create, update: if request.resource.data.token == tokenId
        && tokenId.size() > 20 && tokenId.size() < 400
        && request.resource.data.keys().hasOnly(['token', 'userId', 'platform', 'updatedAt']);
    }

    // ─────────────────────────────────────────────
    // MESA_ESTADO — solo la mesa técnica (admin) lo usa
    // ─────────────────────────────────────────────
    match /mesa_estado/{matchId} {
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // CATCH-ALL: todas las demás colecciones
    //  (equipos*, calendario*, jugadores*, noticias, entrevistas,
    //   stats_partido, jugadas_partido, config_torneo, categorias, ...)
    //  - Lectura pública (la app muestra todo sin login)
    //  - Escritura: SOLO admin
    //
    //  Ya no existen las colecciones `usuarios` ni `forma21s`.
    // ─────────────────────────────────────────────
    match /{col}/{docId} {
      allow read: if !(col in ['fcm_tokens', 'mesa_estado']);
      allow write: if isAdmin();
    }
  }
}
